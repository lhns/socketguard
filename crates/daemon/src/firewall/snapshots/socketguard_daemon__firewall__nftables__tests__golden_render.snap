---
source: crates/daemon/src/firewall/nftables.rs
expression: render(&golden_ruleset())
---
table inet socketguard {
	# a:al1:443:tcp:g6:eth0
	counter c5974b503e9ae6ea5 { }
	# a:al1:53:udp:g1:eth0
	counter c9df8651d2d5bf950 { }
	# a:av4:22:tcp:g3:eth0
	counter c026b186ec0a6b738 { }
	# a:ay1:8080:tcp:g1
	counter cd998f0c373c765fb { }
	# a:ay1:8080:tcp:g2:ygg0
	counter c91f26dc41cb2bb42 { }
	# host:eth0
	counter c3b22f5fdf596bb2e { }
	# host:wlan0
	counter c4a59116813a5952f { }
	# managed
	counter c7fdfda5f50a433ae { }
	# overlay:ygg0
	counter c6095c103ed141158 { }
	# v4:app1:22:tcp:g4:eth0
	counter cb4eb05cab53476bc { }
	# v4:app2:53:udp:g5:eth0
	counter cffbfb7eefbced7eb { }
	chain input {
		type filter hook input priority 0; policy accept;
		# always allowed
		ct state established ct direction reply accept
		ct state related accept
		iif lo accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } ip6 hoplimit 255 accept
		icmpv6 type { packet-too-big, destination-unreachable, time-exceeded, parameter-problem } accept
		icmpv6 type mld-listener-query ip6 saddr fe80::/10 accept
		icmpv6 type echo-request limit rate 5/second accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		icmp type echo-request limit rate 5/second accept
		iifname != { "ygg0" } ip6 saddr fe80::/10 ip6 daddr fe80::/10 udp sport 547 udp dport 546 accept
		iifname != { "ygg0" } meta nfproto ipv4 udp sport 67 udp dport 68 accept
		# rules
		iifname "eth0" ip6 daddr fd00::9 udp dport 53 counter name "c9df8651d2d5bf950" accept
		ip6 saddr { fd00::10/128, fd00:5::/32 } ip6 daddr 301::1 tcp dport 8080 counter name "cd998f0c373c765fb" accept
		iifname "ygg0" ip6 saddr { 200:1::5/128 } ip6 daddr 301::1 tcp dport 8080 counter name "c91f26dc41cb2bb42" accept
		iifname "eth0" ip saddr { 198.51.100.0/24 } ip daddr 192.0.2.9 tcp dport 22 counter name "c026b186ec0a6b738" accept
		iifname "eth0" ip saddr { 192.168.1.5/32, 10.0.20.0/24 } tcp dport 22 counter name "cb4eb05cab53476bc" accept
		iifname "eth0" meta nfproto ipv4 udp dport 53 counter name "cffbfb7eefbced7eb" accept
		iifname "eth0" ip6 saddr { fd00:1:2:3::/64, fe80::/10 } ip6 daddr fd00::9 tcp dport 443 counter name "c5974b503e9ae6ea5" accept
		# scopes
		ip6 daddr { fd00::1, 301::1 } limit rate 10/second burst 20 packets log group 7 prefix "sg:managed"
		ip6 daddr { fd00::1, 301::1 } counter name "c7fdfda5f50a433ae" drop
		ip daddr { 192.0.2.9 } limit rate 10/second burst 20 packets log group 7 prefix "sg:managed"
		ip daddr { 192.0.2.9 } counter name "c7fdfda5f50a433ae" drop
		iifname "ygg0" limit rate 10/second burst 20 packets log group 7 prefix "sg:overlay:ygg0"
		iifname "ygg0" counter name "c6095c103ed141158" drop
		iifname "eth0" limit rate 10/second burst 20 packets log group 7 prefix "sg:host:eth0"
		iifname "eth0" counter name "c3b22f5fdf596bb2e" drop
		iifname "wlan0" meta nfproto ipv6 limit rate 10/second burst 20 packets log group 7 prefix "sg:host:wlan0"
		iifname "wlan0" meta nfproto ipv6 counter name "c4a59116813a5952f" drop
	}
}
