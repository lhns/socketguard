#!/bin/sh
# Runs as root after the files are in place, on a fresh install and on an upgrade alike.
# `service install` is safe to repeat and restarts a running daemon onto the new binary.
# Never `uninstall` here: an upgrade is not an uninstall. A pkg has no uninstaller; to remove
# SocketGuard run `sudo socketguard-daemon uninstall` (docs/packaging.md).
set -e
prog="/Library/Application Support/SocketGuard"
# Only root may write where the root-run daemon lives (ADR 0065); the state in the same
# directory (database, Tor and Yggdrasil data) keeps its own owners and modes.
chown root:wheel "$prog" "$prog/socketguard-daemon" "$prog/socketguard"
chmod 755 "$prog" "$prog/socketguard-daemon" "$prog/socketguard"
chown -R root:wheel "$prog/third_party"
chmod -R go-w "$prog/third_party"
exec "$prog/socketguard-daemon" service install
